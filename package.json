{
  "name": "viste-lagato",
  "private": true,
  "version": "0.1.0",
  "description": "Juego 2D de vestir gatos (Phaser 4 + TypeScript + Vite)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite/config.dev.mjs",
    "build": "vite build --config vite/config.prod.mjs",
    "preview": "vite preview --config vite/config.prod.mjs",
    "lint": "eslint . && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "art": "node art/tools/build-art.mjs && node scripts/sync-art.mjs"
  },
  "dependencies": {
    "phaser": "~4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "typescript": "~5.7",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.4.4",
    "vitest": "^3.2.7"
  }
}
